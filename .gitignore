# --- 无后缀文件（通常是 Linux/macOS 可执行文件）---
# 必须放在下面具体后缀规则之前：后面的规则优先，
# 否则 !*.* 会把 *.o/*.obj/*.dll 等全部重新放行
*
!*/
!*.*
!Makefile

# --- 编译产物 ---
*.o
*.obj
*.so
*.dylib
*.dll
*.lib
*.a
*.vcxproj
*.filters
*.slnx
*.sln

# --- 可执行文件 ---
# 如果你的可执行文件有固定名称，建议直接写名字，例如 /main

# Windows 平台的可执行文件
*.exe
*.out
*.app

# --- 编译器产生的调试文件 ---
*.dSYM/
*.pdb
*.idb
*.ilk

# --- IDE 与 编辑器 ---

.kilo/
.opencode/
opencode.json

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio
.vs/
Debug/
Release/
x64/
x86/

# CLion / JetBrains
.idea/
cmake-build-debug/
cmake-build-release/

# 文本编辑器临时文件
*.swp
*~
.DS_Store

# --- 构建系统 ---
# 如果使用 CMake
build/
build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile